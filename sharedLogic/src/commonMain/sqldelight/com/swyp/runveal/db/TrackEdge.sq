-- 매칭된 경로 저장(docs/local-db/local-db-schema-design.md §3.2) — "가본 길" 렌더링 전용. 트랙당
-- 보통 한 줄(seq=0)이고, "지나간 것으로 인정됐는지"는 이제 이 테이블이 아니라 segmentId 기준
-- (`run_segment`/`explored_segment`)으로 따로 관리한다.
CREATE TABLE track_edge (
    track_id      TEXT NOT NULL,
    seq           INTEGER NOT NULL,      -- 트랙 안에서의 순서
    coordinates   TEXT NOT NULL,         -- GeoJSON 순서 그대로 "[[lon,lat],[lon,lat],…]"
    length_meters REAL NOT NULL,         -- 저장 시 GeoMath로 미리 계산
    PRIMARY KEY (track_id, seq),
    FOREIGN KEY (track_id) REFERENCES track(id) ON DELETE CASCADE
);

-- 가본 길 렌더링: 트랙별로 seq 순서대로 읽어 코드에서 한 줄로 합친다
-- (glow 레이어가 조각 경계마다 round cap이 겹치는 문제 — DongAssetRepository.mergeIntoSingleLine 참고)
selectAllEdgesForRendering:
SELECT e.track_id, e.seq, e.coordinates
FROM track_edge e JOIN track t ON t.id = e.track_id
ORDER BY t.started_at_epoch_ms, e.track_id, e.seq;

insertEdge:
INSERT INTO track_edge (track_id, seq, coordinates, length_meters) VALUES (?, ?, ?, ?);
