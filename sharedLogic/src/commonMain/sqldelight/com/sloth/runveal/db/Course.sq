-- 코스를 독립 엔티티로(docs/local-db/local-db-schema-design.md §3.4). 원본 트랙을 지워도 코스는 남는다.
CREATE TABLE course (
    id                  TEXT PRIMARY KEY NOT NULL,  -- UUID
    source_track_id     TEXT,                       -- NULL = 원본 트랙 삭제됨 / 추천 등 트랙 없이 생성
    name                TEXT NOT NULL,
    distance_meters     REAL NOT NULL,
    coordinates         TEXT NOT NULL,              -- "[[lon,lat],…]" 한 줄로 병합된 경로
    start_lat           REAL NOT NULL,
    start_lon           REAL NOT NULL,
    place_name          TEXT,
    created_at_epoch_ms INTEGER NOT NULL,
    -- 아래부터는 `POST /api/v1/routes` 추천 코스를 그대로 저장했을 때만 채워진다(§3.3 B2 "코스 저장").
    -- 러닝 기록을 승격한 코스는 추천 응답 자체가 없어서 전부 NULL.
    route_type          TEXT,                       -- "LOOP" | "ONE_WAY"
    duration_sec        INTEGER,
    elevation_gain_m    INTEGER,
    elevation_profile   TEXT,                       -- "[[누적거리m, 고도m],…]"
    new_road_m          INTEGER,
    new_road_ratio      REAL,
    tags                TEXT,                       -- "[\"PARK\",\"NEW_ROAD\"]"
    segment_ids         TEXT,                       -- "[1203,8812]"
    milestones          TEXT,                       -- MilestoneDto 리스트 JSON
    -- 이 코스로 달려서 기록이 저장된 마지막 시각. NULL = 아직 안 달림("다음에 달려볼 코스" 기준).
    last_run_at_epoch_ms INTEGER,
    FOREIGN KEY (source_track_id) REFERENCES track(id) ON DELETE SET NULL
);

CREATE INDEX course_created_at_idx ON course(created_at_epoch_ms DESC);

selectAllCourses:
SELECT id, name, distance_meters, coordinates, route_type, duration_sec, new_road_m, created_at_epoch_ms, last_run_at_epoch_ms
FROM course ORDER BY created_at_epoch_ms DESC;   -- "내 코스" 탭 목록 — 바로 시작/썸네일에 coordinates가 필요해서 같이 읽는다

selectCourseById:
SELECT * FROM course WHERE id = ?;

insertCourse:
INSERT INTO course (
    id, source_track_id, name, distance_meters, coordinates,
    start_lat, start_lon, place_name, created_at_epoch_ms,
    route_type, duration_sec, elevation_gain_m, elevation_profile,
    new_road_m, new_road_ratio, tags, segment_ids, milestones
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

renameCourse:
UPDATE course SET name = ? WHERE id = ?;

-- 이 코스로 달린 기록이 저장됐을 때. 기록을 저장하지 않은(너무 짧은) 러닝은 부르지 않는다.
markCourseRun:
UPDATE course SET last_run_at_epoch_ms = ? WHERE id = ?;

deleteCourse:
DELETE FROM course WHERE id = ?;
