-- 트랙별로 실제 "지나간 것으로 인정된" 구간(docs/api/API.md §4 run_segments, "진실의 원천").
-- `explored_segment`는 이 테이블을 재생해서 언제든 다시 만들 수 있는 캐시다.
--
-- covered_mask는 그 트랙이 **구간의 어느 부분을** 지났는지다(com.sloth.runveal.dong.CoverageMask).
-- 트랙마다 따로 들고 있어야 트랙을 지웠을 때 남은 트랙들만 OR해서 캐시를 다시 만들 수 있고, "이
-- 러닝이 처음 뚫은 부분"도 가려낼 수 있다. 빈 문자열은 "구간 전체"(쪼개 적립 전에 쌓인 행)다.
CREATE TABLE run_segment (
    track_id     TEXT NOT NULL,
    segment_id   INTEGER NOT NULL,
    covered_mask TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (track_id, segment_id),
    FOREIGN KEY (track_id) REFERENCES track(id) ON DELETE CASCADE
);

-- 캐시 재생성(트랙 삭제 후 등) / 기간별 "새로 탐험한 길" 집계 — 둘 다 트랙 시작 시각 순으로 mask를
-- 합쳐 가며 재생한다. 순서가 중요하다: "이번에 처음 덮인 부분"은 그 앞 트랙들을 합친 결과에 따라
-- 달라진다. 같은 시각이면 track_id로 갈라 매번 같은 순서를 보장한다.
--
-- 길이·행정동을 같이 들고 오는 덕에 재생에는 지오메트리가 필요 없다 — mask가 제 샘플 수를 알고
-- 있어서 `length_m / 샘플 수`로 비트당 길이가 나온다(구간마다 MultiLineString을 디코딩하면 기록 탭이
-- 느려진다). `road_segment` 인덱스에 없는 구간은 JOIN에서 빠진다 — 길이를 몰라 집계할 수 없다.
selectAllForReplay:
SELECT rs.track_id, rs.segment_id, rs.covered_mask, t.started_at_epoch_ms,
       seg.adm_cd2, seg.length_m
FROM run_segment rs
JOIN track t ON t.id = rs.track_id
JOIN road_segment seg ON seg.segment_id = rs.segment_id
ORDER BY t.started_at_epoch_ms, t.id, rs.segment_id;

-- 기록 상세 "탐험률 변화" — 그 러닝이 지난 동들. 새로 덮은 게 없는 동(이미 다 가본 길만 달린 경우)도
-- 줄에는 나와야 해서 재생 결과가 아니라 run_segment를 직접 본다.
selectDongsForTrack:
SELECT DISTINCT seg.adm_cd2
FROM run_segment rs
JOIN road_segment seg ON seg.segment_id = rs.segment_id
WHERE rs.track_id = ?;

insertRunSegment:
INSERT OR IGNORE INTO run_segment (track_id, segment_id, covered_mask) VALUES (?, ?, ?);
