            "typography": "{typography.caption.s-regular}",
            "color": "{semantic.text.tertiary}"
          }
        }
      }
    },
    "TabBar": {
      "figma": "171:455",
      "description": "플로팅 GNB. Floating=단독(글래스), Embedded=Home Bottom Panel 안(글래스 효과는 바깥 패널이 담당)",
      "props": {
        "items": "TabItem x4 (홈, 내 코스, 기록, MY)",
        "selectedIndex": "number",
        "container": [
          "floating",
          "embedded"
        ]
      },
      "layout": {
        "height": "{layout.size.tab-bar}",
        "width": "화면 너비 - 좌우 {layout.margin.screen}",
        "padding": "{primitive.space.4}",
        "gap": "{primitive.space.4}",
        "radius": "{primitive.radius.full}",
        "position": "하단, 내비게이션 바 WindowInsets 위"
      },
      "styles": {
        "floating": {
          "background": "{semantic.surface.default}",
          "border": {
            "color": "{semantic.border.default}",
            "width": 1
          },
          "backdropBlur": "{effect.glass.blur}",
          "fallbackBackground": "{effect.glass.fallback-surface}",
          "fallbackBorder": "{semantic.border.subtle}"
        },
        "embedded": {
          "background": "{semantic.surface.default}",
          "border": {
            "color": "{semantic.border.default}",
            "width": 1
          },
          "backdropBlur": null
        }
      }
    },
    "SegmentedToggle": {
      "figma": "169:384",
      "description": "지도 보기 전환 토글(탐험한 길 / 안 가본 길)",
      "props": {
        "options": "string[]",
        "selectedIndex": "number"
      },
      "layout": {
        "height": "{layout.size.segmented-toggle}",
        "padding": "{primitive.space.4}",
        "gap": "{primitive.space.4}",
        "radius": "{primitive.radius.full}"
      },
      "styles": {
        "container": {
          "background": "{semantic.surface.default}",
