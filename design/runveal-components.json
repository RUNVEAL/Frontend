      "note": "출발지·도착지에서 '현위치' 선택"
    }
  },
  "components": {
    "Button": {
      "figma": "168:327",
      "description": "버튼. Gold=러닝 이후 주요 행동, Secondary=일반 버튼, Danger=삭제처럼 되돌릴 수 없는 행동. 너비는 내용에 맞춤 또는 꽉 채움",
      "props": {
        "label": "string",
        "style": [
          "gold",
          "secondary",
          "danger"
        ],
        "state": [
          "default",
          "pressed",
          "disabled"
        ],
        "fillWidth": "boolean"
      },
      "layout": {
        "height": "{layout.size.button-height}",
        "paddingHorizontal": "{primitive.space.24}",
        "gap": "{primitive.space.8}",
        "radius": "{primitive.radius.full}",
        "align": "center"
      },
      "typography": {
        "label": "{typography.label.button}"
      },
      "styles": {
        "gold": {
          "background": "{semantic.accent.default}",
          "label": "{semantic.text.on-accent}"
        },
        "secondary": {
          "background": "{semantic.surface.default}",
          "border": {
            "color": "{semantic.border.default}",
            "width": 1
          },
          "backdropBlur": "{effect.glass.blur}",
          "fallbackBackground": "{effect.glass.fallback-surface}",
          "fallbackBorder": "{semantic.border.subtle}",
          "label": "{semantic.text.primary}"
        },
        "danger": {
          "background": "{semantic.surface.default}",
          "border": {
            "color": "{semantic.border.default}",
            "width": 1
          },
          "backdropBlur": "{effect.glass.blur}",
          "fallbackBackground": "{effect.glass.fallback-surface}",
          "fallbackBorder": "{semantic.border.subtle}",
          "label": "{semantic.status.error}"
        }
      },
      "states": {
        "pressed": {
          "gold": {
            "overlay": "{semantic.state.pressed-on-accent}"
          },
          "secondary": {
            "overlay": "{semantic.state.pressed-on-surface}"
          },
          "danger": {
            "overlay": "{semantic.state.pressed-on-surface}"
          }
        },
        "disabled": {
          "opacity": 0.4
        }
      }
    },
    "IconButton": {
      "figma": "168:354",
      "description": "지도 위 원형 버튼. L=코스 만들기, 내 위치 / M=헤더 옆 작은 버튼(터치 영역 48 확보)",
      "props": {
        "icon": "icon",
        "size": [
          "l",
          "m"
        ],
        "state": [
          "default",
          "pressed"
        ],
        "contentDescription": "string"
      },
      "layout": {
        "size": {
          "l": "{layout.size.icon-button-l}",
          "m": "{layout.size.icon-button-m}"
        },
        "touchTargetMin": "{layout.size.touch-target-min}",
        "radius": "{primitive.radius.full}",
        "iconSize": "{layout.size.icon}"
      },
      "styles": {
        "default": {
          "background": "{semantic.surface.default}",
          "border": {
            "color": "{semantic.border.default}",
            "width": 1
          },
          "backdropBlur": "{effect.glass.blur}",
          "fallbackBackground": "{effect.glass.fallback-surface}",
          "fallbackBorder": "{semantic.border.subtle}",
          "icon": "{semantic.icon.primary}"
        }
      },
      "states": {
        "pressed": {
          "overlay": "{semantic.state.pressed-on-surface}"
        }
      }
    },
    "MapAction": {
      "figma": "168:355",
      "description": "IconButton L + 아래 라벨. 지도 하단 코스 만들기, 내 위치",
      "props": {
        "icon": "icon",
        "label": "string"
      },
      "layout": {
        "direction": "vertical",
        "gap": "{primitive.space.8}",
        "align": "center"
      },
      "parts": {
        "button": "IconButton(size=l)",
        "label": {
          "typography": "{typography.caption.m-regular}",
          "color": "{semantic.text.secondary}"
        }
      }
    },
    "RunStartButton": {
      "figma": "168:372",
      "description": "러닝 시작 원형 버튼",
      "props": {
        "label": "string(기본 '러닝 시작')",
        "state": [
          "default",
          "pressed"
        ]
      },
      "layout": {
        "size": "{layout.size.run-start}",
        "radius": "{primitive.radius.full}",
        "direction": "vertical",
        "gap": "{primitive.space.4}",
        "align": "center"
      },
      "styles": {
        "default": {
          "background": "{semantic.accent.default}",
          "icon": "play / {semantic.icon.on-accent}",
          "label": {
            "typography": "{typography.label.button}",
            "color": "{semantic.text.on-accent}"
          }
        }
      },
      "states": {
        "pressed": {
          "overlay": "{semantic.state.pressed-on-accent}"
        }
      }
    },
    "TopAppBar": {
      "figma": "169:337",
      "description": "상단 앱바. 배경 투명(화면 위에 얹음). Close=흐름 종료(러닝 결과), Back=하위 화면",
      "props": {
        "leading": [
          "close",
          "back"
        ],
        "title": "string?(없으면 숨김)"
      },
      "layout": {
        "height": "{layout.size.top-app-bar}",
        "paddingStart": "{primitive.space.4}",
        "paddingEnd": "{primitive.space.16}",
        "gap": "{primitive.space.4}",
        "leadingTouchTarget": "{layout.size.touch-target-min}"
      },
      "parts": {
        "leadingIcon": {
          "close": "icon/close",
          "back": "icon/back",
          "color": "{semantic.icon.primary}"
        },
        "title": {
          "typography": "{typography.heading.3}",
          "color": "{semantic.text.primary}"
        }
      }
    },
    "TabItem": {
      "figma": "169:350",
      "description": "GNB 탭 하나",
      "props": {
        "icon": "icon",
        "label": "string",
        "state": [
          "active",
          "inactive"
        ]
      },
      "layout": {
        "height": 48,
        "width": "fill(4등분)",
        "radius": "{primitive.radius.full}",
        "direction": "vertical",
        "gap": "{primitive.space.2}",
        "align": "center"
