<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>pretendard_regular.otf</string>
		<string>pretendard_semibold.otf</string>
		<string>geist_extralight.ttf</string>
		<string>geist_light.ttf</string>
	</array>
	<!-- 지도에 현재 위치를 띄우고 러닝 경로를 기록하는 데 필요하다. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>내 주변 탐험 지도를 보여주고, 달린 경로를 기록하려면 위치 정보가 필요해요.</string>
	<!-- '항상 허용'이면 화면이 꺼진 동안에도 러닝 기록이 끊기지 않는다(Android의 백그라운드 위치와 같은 역할). -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>화면이 꺼져 있어도 러닝 경로를 계속 기록하려면 위치 정보가 항상 필요해요.</string>
	<!-- Android Foreground Service 대신 iOS는 백그라운드 위치 모드로 기록을 잇는다. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- HTTPS 외에 자체 암호화를 쓰지 않아 수출 규정 면제 대상이다. 이 키가 없으면
	     업로드마다 App Store Connect가 수출 규정 질문을 띄워 자동 배포가 멈춘다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 다크 모드 단일 테마 — 시스템 설정과 무관하게 항상 다크로 고정한다(Android와 같다). -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Firebase Analytics 수집을 기본으로 꺼 둔다. 릴리즈 빌드만 iOSApp.init에서 다시 켠다
	     (Android는 같은 역할을 AndroidManifest의 firebase_analytics_collection_enabled가 한다).

	     여기서 끄는 이유: 이 값은 SDK가 켜지기 전에 읽히므로, 앱이 시작하고 런타임으로 끄기까지의
	     짧은 사이에 자동 이벤트(first_open 등)가 새 나가는 틈이 없다. 한 번 런타임으로 켜면 그
	     선택이 기기에 저장되므로, 디버그 빌드를 깔았던 기기에서도 릴리즈를 깔면 정상 수집된다. -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
</dict>
</plist>
