<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Firebase App Distribution용 export 옵션 (`xcodebuild -exportArchive`).
	  TestFlight용은 ExportOptions-AppStore.plist — 같은 아카이브에서 두 번 export한다.

	  **App Store 프로파일로 만든 IPA는 기기에 바로 설치할 수 없다.** Firebase App Distribution은
	  TestFlight와 달리 Apple을 거치지 않고 IPA를 직접 내려주므로 Ad Hoc 프로파일이 따로 필요하고,
	  그 프로파일에 **테스터 기기 UDID가 등록돼 있어야** 한다. 테스터가 늘면 Developer 포털에서
	  기기를 추가하고 프로파일을 다시 만들어 시크릿을 갱신해야 한다 — TestFlight엔 없는 비용이다.

	  teamID와 provisioningProfiles 값은 워크플로우가 채운다.
	-->
	<key>method</key>
	<!-- Xcode 15.3부터 ad-hoc의 새 이름. 예전 이름(ad-hoc)도 아직 받아 준다. -->
	<string>release-testing</string>

	<key>destination</key>
	<string>export</string>

	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<key>teamID</key>
	<string></string>

	<!-- 키는 번들 ID다 — Config.xcconfig의 PRODUCT_BUNDLE_IDENTIFIER와 같아야 한다. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.swyp.runveal</key>
		<string></string>
	</dict>

	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
