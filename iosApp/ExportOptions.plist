<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  `xcodebuild -exportArchive`에 넘기는 옵션.

	  teamID는 비워 둔다 — 워크플로우가 IOS_TEAM_ID 시크릿으로 채운다
	  (.github/workflows/build-ios.yml). plist는 $(VAR) 치환을 하지 않아서 값으로 직접 써야 한다.
	-->
	<key>method</key>
	<string>app-store-connect</string>

	<key>destination</key>
	<string>export</string>

	<!-- App Store Connect API 키 + -allowProvisioningUpdates로 프로파일을 Xcode가 직접 받아 간다.
	     인증서·프로파일을 시크릿으로 넣는 수동 방식으로 바꾸려면 manual로 고치고
	     provisioningProfiles 딕셔너리를 추가한다. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<key>teamID</key>
	<string></string>

	<!-- 크래시 심볼화를 위해 dSYM을 함께 올린다. -->
	<key>uploadSymbols</key>
	<true/>

	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
