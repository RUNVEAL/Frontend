<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      광고 ID 권한. Firebase Analytics가 전이 의존으로 끌고 오는 play-services-ads-identifier가
      매니페스트 머지로 **이미 넣고 있다**(머지된 release 매니페스트에서 확인했다) — 그래서 이
      선언은 동작을 바꾸지 않는다.

      그래도 적어 두는 이유: 앱이 광고 ID를 쓴다는 사실이 전이 의존 안에만 숨어 있으면 다음
      사람이 놓친다. Play 데이터 보안 설문에서 "광고 ID 수집"을 '예'로 답해야 하는 근거가 이
      한 줄이다. Analytics를 걷어내면 이 선언도 같이 지워야 한다.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!--
      자동 백업(allowBackup)을 끈다. 켜 두면 앱을 지웠다 다시 깔아도 Android가 예전 데이터를
      그대로 복원하는데, 그때 **스키마가 옛 버전인 runveal.db까지 복원**돼서 앱이 시작하자마자
      죽는다(`no such table: explored_segment`). 이 프로젝트엔 SQLDelight 마이그레이션(.sqm)이
      없어서 복원된 옛 DB가 새 스키마로 올라가지 못하기 때문이다.

      지금은 러닝 기록이 서버에 올라가지 않아 백업을 꺼도 잃는 게 없다. 정식 출시로 가면서
      기기 교체 시 기록을 지켜 주려면, 그때 마이그레이션을 설계하고 백업을 다시 켜야 한다.
    -->
    <application
        android:name=".RunVealApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Runveal">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:theme="@style/Theme.Runveal.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Health Connect 권한 근거 화면 — 권한 화면의 "개인정보처리방침" 링크가 여기로 온다.
          앱 본체(MainActivity)가 아니라 따로 둔 이유는 PrivacyPolicyActivity 주석 참고(앱이 꺼져
          있을 때도 들어오는 인텐트라, 본체로 받으면 스플래시를 거쳐 앱 첫 화면이 열려 버린다).

          두 경로를 다 받는다. Android 13 이하는 Health Connect가 별도 앱이라 androidx가 정의한
          ACTION_SHOW_PERMISSIONS_RATIONALE로, 14+는 OS에 포함돼 표준 VIEW_PERMISSION_USAGE로 묻는다.
        -->
        <activity
            android:name="com.sloth.runveal.PrivacyPolicyActivity"
            android:exported="true"
            android:theme="@style/Theme.Runveal">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          android:permission으로 시스템(권한 관리자)만 열 수 있게 막는다. exported=true지만 이
          권한을 가진 건 OS뿐이라 다른 앱은 띄울 수 없다.
        -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="com.sloth.runveal.PrivacyPolicyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Firebase Analytics 수집을 켤지 — 값은 build.gradle.kts의 manifestPlaceholders가 넣는다
          (defaultConfig에서 false, release에서만 true). 꺼져 있으면 SDK가 이벤트를 모으지도
          보내지도 않는다.

          Gradle 설정을 스위치로 둔 이유: 런타임에 BuildConfig.DEBUG로 끄면 앱이 시작되고 이 값을
          적용하기까지의 짧은 사이에 자동 이벤트(first_open 등)가 이미 나갈 수 있다. 매니페스트
          값은 SDK가 켜지기 전에 읽히므로 그 틈이 없다.
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${analyticsCollectionEnabled}" />

        <!--
          카카오 계정 로그인(웹)이 끝나고 커스텀 스킴으로 돌아올 때 인증 코드를 받는 SDK 액티비티.
          카카오 SDK가 매니페스트에 넣어 주지 않아서 앱이 직접 선언해야 한다 — 없으면 카카오톡이
          안 깔린 기기에서 로그인이 돌아올 곳을 못 찾아 그대로 끝난다. 스킴의 앱 키는
          build.gradle.kts의 manifestPlaceholders가 local.properties에서 채운다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="kakao${kakaoNativeAppKey}" />
            </intent-filter>
        </activity>
    </application>

</manifest>
