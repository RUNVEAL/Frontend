<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      러닝 결과를 이미지로 저장할 때만 쓴다(`GalleryImageSaver`).

      Android 10(Q)부터는 MediaStore가 권한 없이 받아 주므로 maxSdkVersion으로 잘라 둔다 — 안 자르면
      최신 기기에서도 권한 목록에 "저장 공간"이 뜨고, 스토어 심사에서 쓰지 않는 권한으로 잡힌다.
      이 앱의 minSdk가 28이라 9 이하 기기에서만 실제로 요청된다.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

</manifest>
