<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Health Connect 읽기 권한. 런타임 권한이지만 보통의 dangerous permission과 달리 OS 다이얼로그가
      아니라 Health Connect 앱 화면에서 사용자가 허용한다(요청은 rememberHealthConnectPermissionState
      가 PermissionController 계약으로 띄운다). 권한 근거 화면 선언은 Activity를 가리켜야 해서
      androidApp:app 매니페스트에 있다.

      READ_EXERCISE_ROUTES(복수)가 핵심이다 — Runveal은 GPS 좌표를 도로에 매칭해야 하므로 경로를
      못 읽으면 거리·시간만 받아도 쓸 데가 없다. 단수형 READ_EXERCISE_ROUTE는 세션을 하나씩
      사용자에게 물어보는 방식이라 일괄 가져오기에 못 쓴다.
      주의: 복수형 권한은 Play 배포 시 Google의 Health Connect 데이터 접근 승인이 필요하다
      (기술적 차단이 아니라 정책 심사라, 개발 빌드에서는 그대로 동작한다).
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />

    <!--
      30일보다 오래된 기록을 읽는 권한. 없으면 읽기 권한을 줘도 지난 30일치만 올라와서 첫 연동의
      90일 조회가 30일로 잘린다. 경로와 달리 제한 데이터가 아니라 승인 없이 받을 수 있다.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

</manifest>
