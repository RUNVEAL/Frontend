<?xml version="1.0" encoding="utf-8"?>
<!--
  지도 위 현재 위치 점. 디자인시스템 `RunvealMapMarker(type = Current)`와 같은 모양이다 —
  18dp 원, 채우기 map/location, 2dp 테두리 icon/primary. 그쪽은 Compose 컴포저블이라 MapLibre
  위치 컴포넌트에 넘길 수 없어 같은 값으로 벡터를 따로 둔다(토큰이 바뀌면 여기도 고친다).

  테두리는 가운데 정렬로 그려지므로 반지름 8 + 선 2 = 바깥 지름 18dp가 된다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:viewportWidth="18"
    android:viewportHeight="18">
    <path
        android:pathData="M9,9m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"
        android:fillColor="#4286E0"
        android:strokeColor="#F4EEEA"
        android:strokeWidth="2" />
</vector>
