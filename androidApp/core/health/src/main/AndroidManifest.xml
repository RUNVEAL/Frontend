<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Health Connect 읽기 권한. 런타임 권한이지만 보통의 dangerous permission과 달리 OS 다이얼로그가
      아니라 Health Connect 앱 화면에서 사용자가 허용한다(요청은 화면 작업에서
      PermissionController.createRequestPermissionResultContract()로 붙인다).

      READ_EXERCISE_ROUTES(복수)가 핵심이다 — Runveal은 GPS 좌표를 도로에 매칭해야 하므로 경로를
      못 읽으면 거리·시간만 받아도 쓸 데가 없다. 단수형 READ_EXERCISE_ROUTE는 세션을 하나씩
      사용자에게 물어보는 방식이라 일괄 가져오기에 못 쓴다.
      주의: 복수형 권한은 Play 배포 시 Google의 Health Connect 데이터 접근 승인이 필요하다
      (기술적 차단이 아니라 정책 심사라, 개발 빌드에서는 그대로 동작한다).
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />

    <!--
      Android 13 이하에서는 Health Connect가 별도 앱(APK)이라, 설치 여부를 확인하려면 패키지
      가시성 선언이 필요하다. 없으면 getSdkStatus()가 설치돼 있어도 SDK_UNAVAILABLE로 보인다.
      Android 14+는 OS에 포함돼 이 선언과 무관하게 동작한다.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

</manifest>
